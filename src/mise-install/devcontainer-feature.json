{
  "id": "mise-install",
  "version": "1.1.0",
  "name": "mise-install",
  "documentationURL": "http://github.com/bcachet/devcontainers-features/tree/main/src/mise-install",
  "description": "Install list of tools through mise",
  "options": {
    "tools": {
      "default": "",
      "description": "Comma separated list of tools.",
      "proposals": [
        "clojure",
        "go,go:golang.org/x/tools/gopls"
      ],
      "type": "string"
    }
  },
  "dependsOn": {
    "ghcr.io/devcontainers-extra/features/mise": {}
  },
  "postStartCommand": {
    "install": "mise trust --yes --quiet && mise install --yes",
    "bash": "echo 'eval \"$(mise activate bash)\"' >> ~/.bashrc",
    "zsh": "echo 'eval \"$(mise activate zsh)\"' >> ~/.zshrc",
    "fish": "mkdir -p ~/.config/fish/ && echo 'mise activate fish | source' >> ~/.config/fish/config.fish"
  }
}