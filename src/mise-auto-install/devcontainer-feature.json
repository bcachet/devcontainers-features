{
  "id": "mise-auto-install",
  "version": "1.0.3",
  "name": "mise-auto-install",
  "documentationURL": "http://github.com/bcachet/devcontainers-features/tree/main/src/mise-auto-install",
  "description": "Installs mise and runs mise install on container start",
  "options": {},
  "dependsOn": {
    "ghcr.io/devcontainers-extra/features/mise": {}
  },
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": []
    }
  },
  "postStartCommand": {
    "install": "mise trust --yes --quiet && mise install --yes",
    "bash": "echo 'eval \"$(mise activate bash)\"' >> ~/.bashrc",
    "zsh": "echo 'eval \"$(mise activate zsh)\"' >> ~/.zshrc",
    "fish": "mkdir -p ~/.config/fish/ && echo 'mise activate fish | source' >> ~/.config/fish/config.fish"
  }
}